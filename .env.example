# Copie este arquivo para ".env" para apontar o app para outro backend
# (por exemplo, o backend Spring Boot do projeto de login usado como referência).
#
# Sem essa variável, o app usa expo.extra.apiUrl (app.json) ou a URL
# da API Gateway atual (AWS) como último recurso.
EXPO_PUBLIC_API_URL=http://localhost:8081/fatec/login
